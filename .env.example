# ============================================================
# Cartable Numérique — Fichier d'exemple de Configuration
# Copiez ce fichier vers .env pour personnaliser vos URLs
# ============================================================

# --- Ports de l'application ---
PORT=3001
PORT_PERF=3002

# --- CAS Unicaen (Authentification SSO) ---
CAS_LOGIN_URL=https://cas.unicaen.fr/login
CAS_SERVICE_URL=https://ecampus-vert.unicaen.fr/login/index.php?authCAS=CAS

# --- eCampus / Moodle ---
ECAMPUS_BASE_URL=https://ecampus-vert.unicaen.fr

# --- Webnotes (Relevé de notes Scodoc) ---
WEBNOTES_BASE_URL=https://webnotes.unicaen.fr

# --- UniCloud / Nextcloud (WebDAV) ---
NEXTCLOUD_WEBDAV_URL=https://unicloud.unicaen.fr/remote.php/webdav

# --- Zimbra Mail (IMAP SSL) ---
IMAP_HOST=imap.unicaen.fr
IMAP_PORT=993
